    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\nconst logs = raw.logs \n  || (raw.body && raw.body.logs) \n  || [];\n\nconst ERROR_THRESHOLD = 3;\nconst CRITICAL_KEYWORDS = ['database', 'payment', 'timeout', 'critical', 'fatal'];\n\nconst errorCount = Array.isArray(logs) \n  ? logs.filter(function(l) { return l.level === 'ERROR'; }).length \n  : 0;\n\nconst hasCritical = Array.isArray(logs) \n  ? logs.some(function(l) { \n      return CRITICAL_KEYWORDS.some(function(kw) { \n        return l.message && l.message.toLowerCase().indexOf(kw) !== -1; \n      }); \n    })\n  : false;\n\nconst logsText = Array.isArray(logs)\n  ? logs.map(function(l) { \n      return '[' + (l.service || 'app') + '] ' + l.level + ': ' + l.message; \n    }).join('\\n')\n  : 'No logs';\n\nconst debugRaw = JSON.stringify(raw);\n\nreturn [{\n  json: {\n    logs: logs,\n    logsText: logsText,\n    errorCount: errorCount,\n    hasCritical: hasCritical,\n    shouldAlert: errorCount >= ERROR_THRESHOLD || hasCritical,\n    threshold: ERROR_THRESHOLD,\n    debugRaw: debugRaw\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
