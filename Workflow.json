    {
      "parameters": {
        "jsCode": "const ai = $('OpenAI — Analyze Logs').item.json.choices[0].message.content;\nconst severity = $('Enrich Alert Data').item.json.severity;\nconst errorCount = $('Enrich Alert Data').item.json.errorCount;\nconst alertTime = $('Enrich Alert Data').item.json.alertTime;\nconst logsText = $('Enrich Alert Data').item.json.logsText;\n\nconst color = severity === 'CRITICAL' ? '#ff4444' : severity === 'HIGH' ? '#ff8800' : '#ffcc00';\n\nconst html = `<div style=\"font-family:monospace;max-width:580px;background:#0d1117;color:#e6edf3;padding:20px;border-radius:8px\">\n\n<div style=\"border-left:3px solid ${color};padding-left:12px;margin-bottom:16px\">\n  <span style=\"color:${color};font-weight:bold;font-size:16px\">⚡ ${severity} ALERT</span><br>\n  <span style=\"color:#8b949e;font-size:11px\">${alertTime}</span>\n</div>\n\n<table style=\"width:100%;border-collapse:collapse;font-size:12px;margin-bottom:16px\">\n  <tr style=\"background:#161b22\">\n    <td style=\"padding:6px 10px;color:#8b949e;border:1px solid #21262d\">Errors</td>\n    <td style=\"padding:6px 10px;color:#f85149;font-weight:bold;border:1px solid #21262d\">${errorCount}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:6px 10px;color:#8b949e;border:1px solid #21262d\">Severity</td>\n    <td style=\"padding:6px 10px;color:${color};font-weight:bold;border:1px solid #21262d\">${severity}</td>\n  </tr>\n</table>\n\n<div style=\"background:#161b22;border:1px solid #21262d;border-radius:4px;padding:12px;margin-bottom:16px\">\n  <div style=\"color:#58a6ff;font-size:11px;font-weight:bold;margin-bottom:6px\">🤖 AI ANALYSIS</div>\n  <div style=\"color:#e6edf3;font-size:12px;line-height:1.7\">${ai}</div>\n</div>\n\n<div style=\"background:#0d1117;border:1px solid #21262d;border-radius:4px;padding:12px\">\n  <div style=\"color:#3fb950;font-size:11px;font-weight:bold;margin-bottom:6px\">📋 LOGS</div>\n  <pre style=\"margin:0;color:#8b949e;font-size:10px;white-space:pre-wrap\">${logsText}</pre>\n</div>\n\n</div>`;\n\nreturn [{ json: { html, subject: `🚨 [${severity}] LogPulse — ${errorCount} errors detected` } }];"
      },
